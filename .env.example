# Endereço do site: endereço canônico, prévia em redes sociais, robots.txt e sitemap.xml.
# The site's address: canonical links, social preview, robots.txt and sitemap.xml.
VITE_SITE_URL=https://dorsal.cotoo.dev

# Modo de desenvolvedor: 1 mostra a chave "Simulação" e a aba Log.
# Developer mode: 1 shows the "Dry run" switch and the Log tab.
VITE_X85_DEV=0

# De onde a landing baixa os AppImages (vazio: a raiz do site).
# Where the landing page downloads the AppImages from (empty: the site's root).
# Example: https://github.com/<user>/dorsal/releases/download/v0.1.0
VITE_DOWNLOAD_BASE=
